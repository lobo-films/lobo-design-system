{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "react", "jsx-a11y", "import", "unicorn", "oxc", "promise"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": ["dist/**", "dist-ssr/**", "coverage/**", "storybook-static/**"],
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "eslint/array-callback-return": "error",
    "eslint/curly": ["error", "all"],
    "eslint/default-case-last": "error",
    "eslint/default-param-last": "error",
    "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],
    "eslint/max-depth": ["warn", 4],
    "eslint/max-params": ["warn", { "max": 4 }],
    "eslint/no-alert": "error",
    "eslint/no-case-declarations": "error",
    "eslint/no-console": ["warn", { "allow": ["warn", "error"] }],
    "eslint/no-else-return": ["error", { "allowElseIf": false }],
    "eslint/no-empty": "error",
    "eslint/no-fallthrough": "error",
    "eslint/no-implicit-coercion": "error",
    "eslint/no-lonely-if": "error",
    "eslint/no-nested-ternary": "error",
    "eslint/no-new-wrappers": "error",
    "eslint/no-param-reassign": ["error", { "props": true }],
    "eslint/no-prototype-builtins": "error",
    "eslint/no-redeclare": "error",
    "eslint/no-return-assign": "error",
    "eslint/no-self-compare": "error",
    "eslint/no-throw-literal": "error",
    "eslint/no-underscore-dangle": "off",
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "eslint/no-useless-return": "error",
    "eslint/no-var": "error",
    "eslint/object-shorthand": "error",
    "eslint/prefer-const": "error",
    "eslint/prefer-promise-reject-errors": "error",
    "eslint/prefer-template": "error",
    "eslint/radix": "error",
    "eslint/require-await": "error",
    "eslint/yoda": "error",

    "typescript/adjacent-overload-signatures": "error",
    "typescript/array-type": ["error", { "default": "array-simple" }],
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true,
        "minimumDescriptionLength": 10
      }
    ],
    "typescript/consistent-indexed-object-style": "error",
    "typescript/consistent-type-assertions": "error",
    "typescript/consistent-type-definitions": ["error", "interface"],
    "typescript/consistent-type-imports": "error",
    "typescript/no-dynamic-delete": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/no-invalid-void-type": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-nullish-coalescing": "error",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-require-imports": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/prefer-function-type": "error",
    "typescript/prefer-ts-expect-error": "error",

    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "react/react-in-jsx-scope": "off",
    "react/button-has-type": "error",
    "react/checked-requires-onchange-or-readonly": "error",
    "react/hook-use-state": "error",
    "react/jsx-boolean-value": ["error", "never"],
    "react/jsx-curly-brace-presence": ["error", { "props": "never", "children": "never" }],
    "react/jsx-filename-extension": ["error", { "extensions": [".tsx"], "allow": "as-needed" }],
    "react/jsx-fragments": ["error", "syntax"],
    "react/jsx-no-target-blank": "error",
    "react/jsx-no-useless-fragment": "error",
    "react/jsx-pascal-case": "error",
    "react/no-array-index-key": "error",
    "react/no-danger": "error",
    "react/no-unescaped-entities": "error",
    "react/no-unknown-property": "error",
    "react/self-closing-comp": "error",

    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    "import/first": "error",
    "import/newline-after-import": "error",
    "import/no-commonjs": "error",
    "import/no-cycle": "error",
    "import/no-default-export": "error",
    "import/no-duplicates": "error",
    "import/no-mutable-exports": "error",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "**/*.scss"] }],

    "unicorn/consistent-function-scoping": "off",
    "unicorn/error-message": "error",
    "unicorn/filename-case": [
      "error",
      { "cases": { "camelCase": true, "pascalCase": true, "kebabCase": true } }
    ],
    "unicorn/no-abusive-eslint-disable": "error",
    "unicorn/no-document-cookie": "error",
    "unicorn/no-instanceof-array": "error",
    "unicorn/no-nested-ternary": "off",
    "unicorn/no-typeof-undefined": "error",
    "unicorn/no-useless-undefined": "error",
    "unicorn/prefer-add-event-listener": "error",
    "unicorn/prefer-at": "error",
    "unicorn/prefer-date-now": "error",
    "unicorn/prefer-includes": "error",
    "unicorn/prefer-keyboard-event-key": "error",
    "unicorn/prefer-modern-dom-apis": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-number-properties": "error",
    "unicorn/prefer-optional-catch-binding": "error",
    "unicorn/prefer-query-selector": "error",
    "unicorn/prefer-spread": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-structured-clone": "error",
    "unicorn/require-array-join-separator": "error",
    "unicorn/switch-case-braces": "error",
    "unicorn/throw-new-error": "error",

    "oxc/no-barrel-file": "off",
    "oxc/no-const-enum": "error",

    "promise/no-nesting": "error",
    "promise/no-return-wrap": "error",
    "promise/param-names": "error",
    "promise/prefer-await-to-then": "warn"
  },
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "import/no-nodejs-modules": "error"
      }
    },
    {
      "files": ["*.config.{js,mjs,cjs,ts,mts}", "**/*.stories.{ts,tsx}", "src/App.tsx"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["*.config.{js,mjs,cjs,ts,mts}", "scripts/**"],
      "env": {
        "browser": false,
        "node": true
      }
    },
    {
      "files": ["**/*.{test,spec}.{ts,tsx}", "**/__tests__/**"],
      "plugins": ["vitest"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "eslint/max-params": "off"
      }
    }
  ]
}
